<!DOCTYPE html>
<html lang="en">

<head>
	<!-- META DATA -->
	<meta charset="utf-8">
	<meta name="description" content="Pathfinder 1E Campaign Management Tool for local tabletop group at Kadena AB.">
	<meta name="author" content="Harrison Merrill">
	<meta name="slogan" content="Kadena AB Pathfinder Group">
	<meta name="keywords"
		content="Pathfinder, Pathfinder 1E, Harrison Merrill, Wrath of the Righteous, Kadena, Shields, Okinawa, Tabletop, RPG">
	<meta name="theme-color" content="#005633">
	<meta name="color-scheme" content="light dark">
	<meta name="robots" content="noimageindex">
	<meta http-equiv="X-Content-Type-Options" content="nosniff">

	<!-- Auto Refresh, uncomment if needed -->
	<!-- <meta http-equiv="refresh" content="300"> -->

	<title>
		<%= title %>
	</title>

	<!-- Logos and Favicons -->
	<link href="/images/core/favicon.ico" rel="icon">
	<link href="/images/core/favicon-64x.png" rel="icon" sizes="64x64">
	<link href="/images/core/logo_apple180x.png" rel="apple-touch-icon" sizes="180x180">
	<link href="/images/core/logo_icon192x.png" rel="icon" sizes="192x192">
	<link href="/js/manifest.json" rel="manifest">

	<!-- Open Graph Metadata -->
	<meta property="og:title" content="<%= title %>">
	<meta property="og:description"
		content="Pathfinder 1E Campaign Management Tool for local tabletop group at Kadena AB.">
	<meta property="og:image" content="/images/core/logo_icon512x.png">
	<meta property="og:image:width" content="512">
	<meta property="og:image:height" content="512">
	<meta property="og:type" content="website">
	<meta name="twitter:card" content="summary_large_image">

	<!-- TELLS PHONES NOT TO LIE ABOUT THEIR WIDTH-->
	<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">

	<!-- Preconnect to Google Fonts -->
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link rel="stylesheet"
		href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Trade+Winds&family=Cinzel+Decorative:wght@400;700;900&display=swap">

	<!-- Stylesheets -->
	<link href="/dist/styles.css" rel="stylesheet">
	<%- renderStyles() %>

	<!-- Scripts -->
	<script src="/js/theme-preference.js"></script>
	<script src="/js/utilities.js"></script>
	<script src="/js/pathfinder.js"></script>
	<%- renderScripts() %>

	<!-- DEV_ENV Live Reload WebSocket-->
	<% if (NODE_ENV.includes('dev')) { %>
	<script>
		// Get the current hostname and port from the browser
		const host = window.location.hostname;
		const currentPort = window.location.port;

		// Calculate WebSocket port (current port + 1)
		const wsPort = currentPort ? (parseInt(currentPort) + 1) : 3001;

		// Create WebSocket connection using dynamic hostname and port
		const ws = new WebSocket(`ws://${host}:${wsPort}`);
		ws.onclose = () => {
			setTimeout(() => location.reload(), 2000);
		};
	</script>
	<% } %>
</head>