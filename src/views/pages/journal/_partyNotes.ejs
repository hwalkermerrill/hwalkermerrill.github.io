<section id="party-notes">
	<h2>Party Notes</h2>

	<% if (!publicNotes || publicNotes.length === 0) { %>
	<p>No public notes have been shared yet.</p>
	<% } else { %>

	<!-- // Group notes by category -->
	<%  const grouped = {};
      publicNotes.forEach(n => {
        if (!grouped[n.category_name]) grouped[n.category_name] = [];
        grouped[n.category_name].push(n);
	}); %>

	<% Object.keys(grouped).forEach(category => { %>
	<% const list = grouped[category]; %>
	<% if (list.length > 0) { %>

	<div class="note-category-group">
		<h2><%= category %></h2>

		<ul class="note-type-list">
			<% list.forEach(note => { %>
			<li class="note-row"
				data-search="<%= note.note_title %> <%= note.note_content %> <%= note.category_name %> <%= note.pc_id || '' %>">

				<!-- Note Header -->
				<div class="note-row-header">
					<h3><%= note.note_title %></h3>
				</div>

				<!-- Content -->
				<label class="note-expand">
					<input type="checkbox" class="note-toggle">
					<p class="note-content note-collapsible"><%- note.note_content %></p>
				</label>

				<!-- Actions and Metadata -->
				<div class="note-card-footer">
					<div class="note-meta">
						<% const identity = note.pc_name || note.username; %>
						<span class="note-badge identity"><%= identity %></span>
					</div>
					<a href="/notes/<%= note.id %>/edit" class="btn btn-small"> Edit </a>
				</div>

			</li>
			<% }) %>
		</ul>
	</div>

	<% } %>
	<% }) %>
	<% } %>
</section>