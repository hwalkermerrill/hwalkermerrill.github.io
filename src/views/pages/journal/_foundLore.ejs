<%
	// Helper: check if any logs exist across all types
	const hasAnyLogs =
		logsByType &&
		(
			(logsByType.documents && logsByType.documents.length) ||
			(logsByType.dreams && logsByType.dreams.length) ||
			(logsByType.lore && logsByType.lore.length) ||
			(logsByType.npcSpotlight && logsByType.npcSpotlight.length) ||
			(logsByType.other && logsByType.other.length)
		);
%>

<% if (!hasAnyLogs) { %>
<section id="found-lore">
	<h2>Recovered Lore</h2>
	<p>No documents, dreams, lore, or other records have been recovered yet.</p>
</section>
<div class="clearfix"></div>
<% } else { %>

<%
	// Sections in alphabetical order, with display labels
	const sections = [
		{ key: "documents", label: "Documents" },
		{ key: "dreams", label: "Dreams" },
		{ key: "lore", label: "Lore" },
		{ key: "npcSpotlight", label: "NPC Spotlights" },
		{ key: "other", label: "Other Records" }
	];
%>

<section id="found-lore">
	<h2>Recovered Lore & Documents</h2>

	<% sections.forEach(section => { %>
	<%
		const list = logsByType[section.key] || [];
		if (!list.length) return;
	%>

	<div class="document-section">
		<h3><%= section.label %></h3>

		<% list.forEach(log => { %>
		<ul class="toggleLiVis" style="list-style-type:none;" data-log-id="<%= log.id %>"
			data-title="<%- log.title.replace(/"/g, '&quot;') %>" data-type="<%= log.log_type %>">

			<!-- List entry (always visible) -->
			<li>
				<b>Click to read "<%= log.title %>"</b>
			</li>

			<!-- Title (shown when expanded) -->
			<li style="display:none;">
				<b><i><%= log.title %></i></b>
			</li>

			<!-- Main image (if present) -->
			<% if (log.mainImage) { %>
			<li style="display:none;">
				<picture>
					<source srcset="<%= log.mainImage.image_url %>" type="image/webp">
					<img class="pointer <%= log.mainImage.is_tall ? 'tooTall' : 'wide' %>" src="/images/core/placeholder-note.jpg"
						alt="<%= log.mainImage.alt || log.title %>" loading="lazy">
				</picture>
			</li>
			<% } %>

			<!-- Hover image (optional, if present) -->
			<% if (log.hoverImage) { %>
			<li style="display:none;">
				<picture>
					<source srcset="<%= log.hoverImage.image_url %>" type="image/webp">
					<img class="pointer <%= log.hoverImage.is_tall ? 'tooTall' : 'wide' %>"
						src="/images/core/placeholder-note.jpg" alt="<%= log.hoverImage.alt || (log.title + ' (hover)') %>"
						loading="lazy">
				</picture>
			</li>
			<% } %>

			<!-- Body: paragraphs combined -->
			<%
				const bodyText = (log.paragraphs || [])
					.map(p => p.paragraph_text)
					.join("\n\n");
				const safeBody = JSON.stringify(bodyText).replace(/"/g, '&quot;');
			%>
			<li class="item-body" style="display:none;" data-body="<%- safeBody %>"></li>

			<!-- Close hint -->
			<li style="display:none;">
				<i>~ Click to put "<%= log.title %>" away...</i>
			</li>

			<li class="clearfix" style="display:none;"></li>
		</ul>
		<% }); %>
	</div>
	<% }); %>
</section>
<div class="clearfix"></div>
<% } %>