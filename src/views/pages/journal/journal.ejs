<%- include("../../partials/header") %>

<!-- Hero Header Content -->
<main class="clearfix" id="maincontent">
	<h1>What do we <i>Think</i> we know?</h1>

	<!-- Aside Image -->
	<%- include("./_asideImg") %>

	<!-- Current Quest Assignment -->
	<%- include("./_currentQuest") %>

	<!-- Tabbed UI -->
	<%- include("./_tabs") %>

	<!-- Tabbed Section Content -->
	<section id="journal-tab-session" class="journal-tab active">
		<%- include("./_sessionRecap", { latestLog }) %>
		<%- include("./_sessionList", { logsByBook }) %>
	</section>

	<section id="journal-tab-documents" class="journal-tab">
		<%- include("./_foundLore", { logsByType }) %>
	</section>

	<section id="journal-tab-party-notes" class="journal-tab">
		<%- include("./_partyNotes", { publicNotes }) %>
	</section>

	<!-- Logged-in OnlyTabs -->
	<% if (isLoggedIn) { %>
	<section id="journal-tab-player-notes" class="journal-tab">
		<%- include("./_userNotes", { notes: userNotes }) %>
	</section>
	<% } %>
</main>

<%- include("../../partials/footer") %>