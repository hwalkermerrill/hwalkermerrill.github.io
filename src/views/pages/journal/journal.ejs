<%- include("../../partials/header") %>

<!-- Hero Header Content -->
<main class="clearfix" id="maincontent">
	<h1>What do we <i>Think</i> we know?</h1>
	<!-- Aside Image -->
	<%- include("./_asideImg") %>

	<!-- Current Quest Assignment -->
	<%- include("./_currentQuest") %>

	<!-- Tabbed UI -->
	<%- include("./_tabs") %>

	<section id="journal-tab-session" class="journal-tab active">
		<%- include("./_sessionRecap", { latestLog }) %>
		<%- include("./_sessionList", { logsByBook }) %>
	</section>

	<section id="journal-tab-documents" class="journal-tab">
		<%- include("./_foundLore", { items }) %>
	</section>

	<% if (isLoggedIn) { %>
	<section id="journal-tab-notes" class="journal-tab">
		<%- include("./_notes", { notes }) %>
	</section>
	<% } %>
</main>

<%- include("../../partials/footer") %>