<section>
	<h2>Quest Log</h2>
	<p>The active quest log sorts quests by type. Click to reveal quest details or view previous quests.</p>

	<% const typeOrder = ["main","personal","companion","area","side","radiant","other"]; %>
	<% const grouped = {}; %>
	<% quests.forEach(q => { %>
	<% if (!grouped[q.quest_type]) grouped[q.quest_type] = []; %>
	<% grouped[q.quest_type].push(q); %>
	<% }) %>

	<!-- Active quests by type -->
	<% typeOrder.forEach(type => { %>
	<% const list = (grouped[type] || []).filter(q => q.active_status_id === 2); %> <!-- 2 = Active -->
	<% if (list.length === 0) return; %>

	<section class="toggleLiVis">
		<h3><%= type.charAt(0).toUpperCase() + type.slice(1) %> Quests</h3>

		<% list.forEach(q => { %>
		<ul class="questLog <%= q.pinned ? 'pinned' : '' %>" style="list-style-type:circle">
			<li style="list-style-type: none;">
				<b>Click to reveal "<%= q.quest_name %>":</b>
			</li>
			<li style="list-style-type: none; display: none;">
				<b>Click to hide "<%= q.quest_name %>":</b>
			</li>
			<li style="display: none;">
				<b><%= q.quest_name %></b>
				<% if (q.description) { %>
				<p><%= q.description %></p>
				<% } %>
				<% if (q.deadline) { %>
				<p><b>Deadline:</b> <%= q.deadline %></p>
				<% } %>
			</li>
		</ul>
		<% }) %>
	</section>
	<% }) %>

	<!-- Controls for completed/failed (buttons after active list) -->
	<div class="form-row">
		<button type="button" class="btn fmt-btn" id="toggle-completed">Show Completed Quests</button>
		<button type="button" class="btn fmt-btn" id="toggle-failed">Show Failed Quests</button>
	</div>

	<!-- Completed quests -->
	<% 
    const completed = quests.filter(q => q.active_status_id === 3); // 3 = Completed
    completed.sort((a, b) => {
      const aComp = a.session_complete === null ? Infinity : a.session_complete;
      const bComp = b.session_complete === null ? Infinity : b.session_complete;

      if (aComp !== bComp) return bComp - aComp; // higher first, null treated as most recent
      return a.quest_name.localeCompare(b.quest_name);
    });
  %>

	<% if (completed.length > 0) { %>
	<section id="completed-quests" class="toggleLiVis" style="display:none;">
		<h3>Completed Quests</h3>

		<% completed.forEach(q => { %>
		<ul class="questLog <%= q.pinned ? 'pinned' : '' %>" style="list-style-type:circle">
			<li style="list-style-type: none;">
				<b>Click to reveal "<%= q.quest_name %>":</b>
			</li>
			<li style="list-style-type: none; display: none;">
				<b>Click to hide "<%= q.quest_name %>":</b>
			</li>
			<li style="display: none;">
				<b><%= q.quest_name %></b>

				<% if (q.description) { %>
				<p><%= q.description %></p>
				<% } %>

				<p>
					<% if (q.session_received !== null) { %>
					<b>Received:</b> Session <%= q.session_received %><br>
					<% } %>
					<% if (q.session_complete !== null) { %>
					<b>Completed:</b> Session <%= q.session_complete %>
					<% } else { %>
					<b>Completed:</b> Session unknown
					<% } %>
				</p>

				<% if (q.deadline) { %>
				<p><b>Deadline:</b> <%= q.deadline %></p>
				<% } %>
			</li>
		</ul>
		<% }) %>
	</section>
	<% } %>

	<!-- Failed quests -->
	<% 
    const failed = quests.filter(q => q.active_status_id === 4); // 4 = Failed
    failed.sort((a, b) => {
      const aComp = a.session_complete === null ? Infinity : a.session_complete;
      const bComp = b.session_complete === null ? Infinity : b.session_complete;

      if (aComp !== bComp) return bComp - aComp;
      return a.quest_name.localeCompare(b.quest_name);
    });
  %>

	<% if (failed.length > 0) { %>
	<section id="failed-quests" class="toggleLiVis" style="display:none;">
		<h3>Failed Quests</h3>

		<% failed.forEach(q => { %>
		<ul class="questLog <%= q.pinned ? 'pinned' : '' %>" style="list-style-type:circle">
			<li style="list-style-type: none;">
				<b>Click to reveal "<%= q.quest_name %>":</b>
			</li>
			<li style="list-style-type: none; display: none;">
				<b>Click to hide "<%= q.quest_name %>":</b>
			</li>
			<li style="display: none;">
				<b><%= q.quest_name %></b>

				<% if (q.description) { %>
				<p><%= q.description %></p>
				<% } %>

				<p>
					<% if (q.session_received !== null) { %>
					<b>Received:</b> Session <%= q.session_received %><br>
					<% } %>
					<% if (q.session_complete !== null) { %>
					<b>Failed:</b> Session <%= q.session_complete %>
					<% } else { %>
					<b>Failed:</b> Session unknown
					<% } %>
				</p>

				<% if (q.deadline) { %>
				<p><b>Deadline:</b> <%= q.deadline %></p>
				<% } %>
			</li>
		</ul>
		<% }) %>
	</section>
	<% } %>
</section>

<script>
	// Toggle completed section visibility
	document.getElementById("toggle-completed")?.addEventListener("click", () => {
		const section = document.getElementById("completed-quests");
		if (!section) return;
		const isHidden = section.style.display === "none" || section.style.display === "";
		section.style.display = isHidden ? "block" : "none";
	});

	// Toggle failed section visibility
	document.getElementById("toggle-failed")?.addEventListener("click", () => {
		const section = document.getElementById("failed-quests");
		if (!section) return;
		const isHidden = section.style.display === "none" || section.style.display === "";
		section.style.display = isHidden ? "block" : "none";
	});
</script>