<section id="session-recap">
	<h2>Last Time on Wrath of the Righteous</h2>

	<% if (!latestRecap) { %>
	<p>No session recap is available yet.</p>
	<% } else { %>

	<article id="session-recap-content" data-log-id="<%= latestRecap.id %>">
		<h3><%= latestRecap.title %></h3>

		<% if (latestRecap.time_span) { %>
		<p class="u-text-mini u-margin-collapse">&ensp;&ensp;<i>Time Span: <%= latestRecap.time_span %></i></p>
		<% } %>

		<!-- <% if (latestRecap.session_date) { %>
		<p><strong>Session Date:</strong> <%= latestRecap.session_date.toISOString().slice(0,10) %> </p>
		<% } %> -->

		<% if (latestRecap.mainImage) { %>
		<figure class="u-text-center <%= latestRecap.mainImage.is_tall ? 'tooTall' : 'wide' %>">
			<picture>
				<source srcset="<%= latestRecap.mainImage.image_url %>" type="image/webp">
				<img class="pointer" src="/images/core/unknown.png" alt="<%= latestRecap.mainImage.alt %>" loading="lazy">
			</picture>

			<% if (latestRecap.mainImage.figcaption) { %>
			<figcaption class="u-text-mini">
				<%= latestRecap.mainImage.figcaption %>
			</figcaption>
			<% } %>
		</figure>
		<% } %>

		<% latestRecap.paragraphs.forEach(p => { %>
		<p><%= p.paragraph_text %></p>
		<% }) %>

	</article>

	<% } %>
</section>

<div class="clearfix"></div>