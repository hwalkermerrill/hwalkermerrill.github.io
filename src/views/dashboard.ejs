<%- include("partials/header") %>
<main>
	<div class="dashboard">
		<h1>Welcome to Your Dashboard</h1>
		<p> This is a protected page that requires authentication. Only logged-in users can access this content. </p>

		<div class="user-info card">
			<h2>Your Account Information</h2>
			<div class="user-detail">
				<span class="label">Name:</span>
				<span class="value"><%= user.full_name %></span>
			</div>
			<div class="user-detail">
				<span class="label">Username:</span>
				<span class="value"><%= user.username %></span>
			</div>
			<div class="user-detail">
				<span class="label">Role:</span>
				<span class="value"><%= user.roleName %></span>
			</div>
			<div class="user-detail">
				<div class="label">Registered</div>
				<div class="value"><%= new Date(user.created_at).toLocaleDateString() %></div>
			</div>
		</div>

		<!-- Dashboard Action Nav -->
		<nav class="journal-tabs">
			<ul>
				<li><a href="/logout">Logout</a></li>
				<li><a href="/register/account">View Account</a></li>
				<!-- Create Character Builder -->
				<li><a href="/notes/new">Take Notes</a></li>
			</ul>

			<!-- Moderator Tools -->
			<% if (hasRole(user, "moderator") || hasRole(user, "gm_admin")) { %>
			<ul>
				<!-- Create Character Manager -->
				<li><a href="/logs/new">Create Log</a></li>
				<li><a href="/logs/select">Manage Logs</a></li>
			</ul>
			<% } %>

			<!-- GM Tools -->
			<% if (hasRole(user, "gm_admin")) { %>
			<ul>
				<li><a href="/register/account">Manage Users</a></li>
				<li><a href="/register/password-resets">Password Reset Requests</a></li>
			</ul>
			<% } %>
		</nav>

		<!-- <div class="session-debug">
      <h3>Session Information (For Learning Purposes)</h3>
      <p><em>This section shows your current session data for educational purposes.</em></p>
      <pre><%= JSON.stringify(sessionData, null, 2) %></pre>
      <p>
        <strong>If you see a password property in the above object you have a security vulnerability, fix it!</strong>
      </p>
    </div> remove from production-->

		<br>
	</div>
</main>
<%- include('partials/footer') %>