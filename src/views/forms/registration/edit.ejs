<%- include("../../partials/header") %>
<main>
	<h1><%= title %></h1>

	<form method="POST" action="/register/<%= targetUser.id %>/edit">
		<div class="form-field">
			<label for="full_name">Full Name:</label>
			<input type="text" id="full_name" name="full_name" value="<%= targetUser.full_name %>" required>
		</div>

		<div class="form-field">
			<label for="username">Username:</label>
			<input type="text" id="username" name="username" value="<%= targetUser.username %>" required>
		</div>

		<br>
		<div class="form-actions">
			<button type="submit" class="btn">Update Account</button>
			<a href="/register/account">Cancel</a>
		</div>
	</form>
</main>
<%- include('../../partials/footer') %>