<form action="<%= formMode === 'edit'
    ? '/builder/pc/' + pc.id + '/edit/main'
    : '/builder/pc/new' %>" method="POST" class="note-form">

	<!-- Campaign & Status -->
	<div class="form-row">

		<div class="form-field">
			<label for="campaign_id">Campaign</label>
			<select id="campaign_id" name="campaign_id" required>
				<% campaigns.forEach(c => { %>
				<option value="<%= c.id %>"
					<%= ((pc && Number(pc.campaign_id) === Number(c.id) ) || (!pc && Number(campaign_id) === Number(c.id) )) ? "selected" : "" %>>
					<%= c.campaign_name %>
				</option>
				<% }) %>
			</select>
		</div>

		<div class="form-field">
			<label for="active_status_id">Status</label>
			<select id="active_status_id" name="active_status_id" required>
				<% active_status.forEach(s => { %>
				<option value="<%= s.id %>" <%= pc && Number(pc.active_status_id) === Number(s.id)
              ? "selected"
              : "" %>>
					<%= s.active_status_name %>
				</option>
				<% }) %>
			</select>
		</div>

	</div>

	<!-- Names -->
	<div class="form-row">
		<div class="form-field">
			<label for="pc_name">Character Name</label>
			<input type="text" id="pc_name" name="pc_name" maxlength="255" required value="<%= pc ? pc.pc_name : '' %>">
		</div>
	</div>

	<!-- Identified -->
	<div class="form-row">
		<div class="form-field">
			<label for="is_identified">Has the Party Met You?</label>
			<select id="is_identified" name="is_identified">

				<option value="false" <%= pc && !pc.is_identified ? "selected" : "" %>>
					Has NOT Been Introduced
				</option>

				<option value="true" <%= pc && pc.is_identified ? "selected" : "" %>>
					Has Been Introduced
				</option>

			</select>
		</div>

		<div class="form-field">
			<label for="unknown_name">Name while Unidentified</label>
			<input type="text" id="unknown_name" name="unknown_name" maxlength="255"
				value="<%= pc ? (pc.unknown_name || '') : 'Unknown' %>">
		</div>
	</div>

	<!-- Secret Identity -->
	<div class="form-row">

		<div class="form-field">
			<label for="secret_name">Secret Identity</label>
			<input type="text" id="secret_name" name="secret_name" maxlength="255"
				placeholder="Do you have a name you don't tell people?" value="<%= pc ? (pc.secret_name || '') : '' %>">
		</div>

		<!-- Irregular Feature: Use secret colors for spirit animals/ special naming -->
		<!-- <div class="form-field">
			<label for="secret_color">Secret Color (Hex#)</label>
			<input type="text" id="secret_color" name="secret_color" maxlength="64" placeholder="Leave blank unless told otherwise"
				value="<%= pc ? (pc.secret_color || '') : '' %>">
		</div> -->

		<div class="form-field">
			<label for="show_secret_name">Reveal Secret Identity</label>
			<select id="show_secret_name" name="show_secret_name">

				<option value="false" <%= pc && !pc.show_secret_name ? "selected" : "" %>>
					Hidden
				</option>

				<option value="true" <%= pc && pc.show_secret_name ? "selected" : "" %>>
					Visible
				</option>

			</select>
		</div>

	</div>

	<!-- Gender -->
	<div class="form-field">
		<label for="gender_type"> Gender </label>
		<select id="gender_type">

			<option value="non_gendered" <%= pc && !pc.is_gendered ? "selected" : "" %>>
				Non-Gendered
			</option>

			<option value="male" <%= (!pc || (pc.is_gendered && !pc.is_female))
					? "selected"
					: "" %>>
				Male
			</option>

			<option value="female" <%= pc && pc.is_gendered && pc.is_female
					? "selected"
					: "" %>>
				Female
			</option>

		</select>
	</div>

	<input type="hidden" id="is_gendered" name="is_gendered" value="<%= !pc ? 'true' : String(pc.is_gendered) %>">
	<input type="hidden" id="is_female" name="is_female" value="<%= !pc ? 'false' : String(pc.is_female) %>">

	<!-- Description -->
	<div class="form-field">
		<label for="description">Description</label>
		<p>This space can be as full or empty as you like and is hidden from other
			players - its just for you and the GM. Use this field to describe your character concept, motivations for
			adventuring, and any background details you'd like to help you build your character. Feel free to add to this as
			your story progresses.</p>
		<textarea id="description" name="description" rows="6"
			placeholder="Describe your character concept, background, or anything else that helps you and the GM understand the character."><%= pc && pc.description ? pc.description : '' %></textarea>
	</div>

	<!-- Edit Only Fields -->
	<% if (formMode === "edit") { %>

	<div class="form-row">

		<div class="form-field" id="retired-reason-wrapper">
			<label for="retired_reason">Retired Reason</label>
			<textarea id="retired_reason" name="retired_reason" rows="4"><%= pc.retired_reason || '' %></textarea>
		</div>

		<div class="form-field" id="death-cause-wrapper">
			<label for="death_cause">Death Cause</label>
			<textarea id="death_cause" name="death_cause" rows="4"><%= pc.death_cause || '' %></textarea>
		</div>

		<!-- Feature to Add: -->
		<!-- Add a current session feature. Once implemented, have this value default to the current session number, but ONLY while the status is set to 3 or 4 -->
		<div class="form-field" id="end-session-wrapper">
			<label for="end_session">Final Session Number</label>
			<input type="number" id="end_session" name="end_session" min="1" placeholder="Cannot be left blank"
				value="<%= pc.end_session || '' %>">
		</div>

	</div>

	<% } %>

	<!-- Formatting Buttons -->
	<div class="form-formatting">
		<button type="button" class="btn fmt-btn" data-tag="b"><b>Bold</b></button>
		<button type="button" class="btn fmt-btn" data-tag="i"><i>Italic</i></button>
		<button type="button" class="btn fmt-btn" data-tag="q"><b>Quote</b></button>
		<button type="button" class="btn fmt-btn" data-tag="sup">Sup</button>
		<button type="button" class="btn fmt-btn" data-tag="sub">Sub</button>
	</div>

	<!-- Actions -->
	<div class="form-actions">

		<button type="submit" class="btn btn-primary">
			<%= formMode === "edit" ? "Save Main Information and Continue" : "Create Character" %>
		</button>

		<a href="/builder/characters" class="btn fmt-btn">
			Cancel
		</a>

	</div>

</form>