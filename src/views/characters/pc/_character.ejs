<form action="/builder/pc/<%= pc.id %>/edit/character" method="POST" class="note-form">

	<!-- Race -->
	<div class="form-row">

		<div class="form-field">
			<label for="race_id"> Race </label>
			<select id="race_id" name="race_id">

				<option value=""> Select Race </option>

				<% races.forEach(race => { %>
				<option value="<%= race.id %>" <%= pc && Number(pc.race_id) === Number(race.id)
              ? "selected"
              : "" %>>
					<%= race.name %>
				</option>
				<% }) %>

			</select>
		</div>

		<div class="form-field">
			<label for="race_traits"> Racial Traits </label>
			<textarea id="race_traits" name="race_traits" rows="5"><%= pc?.race_traits || '' %></textarea>
		</div>

	</div>

	<!-- Religion -->
	<div class="form-row">

		<div class="form-field">
			<label for="religion_id"> Religion </label>
			<select id="religion_id" name="religion_id">

				<option value=""> Select Religion </option>

				<% religions.forEach(religion => { %>
				<option value="<%= religion.id %>" <%= (pc?.religions || []).includes(religion.id)
              ? "selected"
              : "" %>>
					<%= religion.name %>
				</option>
				<% }) %>

			</select>
		</div>

		<div class="form-field">
			<label for="religion_notes"> Religion Notes </label>
			<textarea id="religion_notes" name="religion_notes" rows="4"></textarea>
		</div>

	</div>

	<div class="form-field">
		<label for="religion_secrets"> Religion Secrets </label>
		<textarea id="religion_secrets" name="religion_secrets" rows="4"></textarea>
	</div>

