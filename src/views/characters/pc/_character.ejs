	<!-- Languages -->
	<div id="language-container">
		<% if (pc.languages && pc.languages.length) { %>
		<% pc.languages.forEach(languageId => { %>
		<div class="language-row">
			<select name="language_ids">
				<% languages.forEach(language => { %>
				<option value="<%= language.id %>" <%= Number(language.id) === Number(languageId) ? "selected" : "" %>>
					<%= language.name %>
				</option>
				<% }) %>
			</select>
		</div>
		<% }) %>
		<% } %>
	</div>

	<!-- Language Buttons -->
	<button type="button" class="btn fmt-btn" id="add-language">
		+ Add Language
	</button>

	<button type="button" class="btn fmt-btn" id="remove-language">
		- Remove Language
	</button>

	<!-- Classes -->
	<div id="class-container">
		<% if (pc.classes && pc.classes.length) { %>
		<% pc.classes.forEach((cls, index) => { %>
		<div class="class-row">
			<div class="form-row">

				<div class="form-field">
					<label>Class</label>
					<select name="classes[<%= index %>][class_id]">

						<option value=""> Select Class </option>

						<% classes.forEach(classOption => { %>
						<option value="<%= classOption.id %>"
							<%= Number(classOption.id) === Number(cls.class_id) ? "selected" : "" %>>
							<%= classOption.name %>
						</option>
						<% }) %>

					</select>
				</div>

				<div class="form-field">
					<label>Level</label>
					<input type="number" min="1" name="classes[<%= index %>][class_level]" value="<%= cls.class_level || 1 %>">
				</div>

			</div>

			<div class="form-field">
				<label>Archetypes</label>
				<input type="text" name="classes[<%= index %>][archetypes]" value="<%= cls.archetype_name || '' %>">
			</div>

		</div>
		<% }) %>
		<% } %>
	</div>

	<!-- Class Buttons -->
	<button type="button" class="btn fmt-btn" id="add-class">
		+ Add Class
	</button>

	<button type="button" class="btn fmt-btn" id="remove-class">
		- Remove Class
	</button>

	<!-- Formatting Buttons -->
	<div class="form-formatting">
		<button type="button" class="btn fmt-btn" data-tag="b"><b>Bold</b></button>
		<button type="button" class="btn fmt-btn" data-tag="i"><i>Italic</i></button>
		<button type="button" class="btn fmt-btn" data-tag="q"><b>Quote</b></button>
		<button type="button" class="btn fmt-btn" data-tag="sup">Sup</button>
		<button type="button" class="btn fmt-btn" data-tag="sub">Sub</button>
	</div>

	<!-- Actions -->
	<div class="form-actions">

		<button type="submit" class="btn btn-primary">
			Save Character Information
		</button>

		<a href="/builder/pc/<%= pc.id %>/edit?tab=social" class="btn fmt-btn">
			Back
		</a>

	</div>

</form>