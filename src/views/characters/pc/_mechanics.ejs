<form action="/builder/pc/<%= pc.id %>/edit/mechanics" method="POST" class="note-form">

	<h2>Attributes</h2>
	<div class="form-row">

		<div class="form-field">
			<label>STR</label>
			<input type="number" name="attributes[strength]" value="">
		</div>

		<div class="form-field">
			<label>DEX</label>
			<input type="number" name="attributes[dexterity]" value="">
		</div>

		<div class="form-field">
			<label>CON</label>
			<input type="number" name="attributes[constitution]" value="">
		</div>

	</div>

	<div class="form-row">

		<div class="form-field">
			<label>INT</label>
			<input type="number" name="attributes[intelligence]" value="">
		</div>

		<div class="form-field">
			<label>WIS</label>
			<input type="number" name="attributes[wisdom]" value="">
		</div>

		<div class="form-field">
			<label>CHA</label>
			<input type="number" name="attributes[charisma]" value="">
		</div>

	</div>

	<div class="form-row">

		<div class="form-field">
			<label for="alignment">Alignment</label>
			<input type="text" id="alignment" name="attributes[alignment]" value="">
		</div>

		<div class="form-field">
			<label>Attribute Notes</label>
			<textarea rows="4" name="attributes[notes]"></textarea>
		</div>

	</div>

	<h2>Combat Statistics</h2>

	<div class="form-row">

		<div class="form-field">
			<label>AC</label>
			<input type="number" name="stats[main_ac]">
		</div>

		<div class="form-field">
			<label>Flat AC</label>
			<input type="number" name="stats[flat_ac]">
		</div>

		<div class="form-field">
			<label>Touch AC</label>
			<input type="number" name="stats[touch_ac]">
		</div>

	</div>

	<div class="form-row">

		<div class="form-field">
			<label>CMD</label>
			<input type="number" name="stats[cmd]">
		</div>

		<div class="form-field">
			<label>Max HP</label>
			<input type="number" name="stats[max_hp]">
		</div>

	</div>

	<div class="form-field">
		<label>Conditional Modifiers</label>
		<textarea rows="4" name="stats[notes]"></textarea>
	</div>

	<h2>Skills & Saves</h2>

	<div class="form-row">

		<div class="form-field">
			<label>Initiative</label>
			<input type="number" name="skills[initiative]">
		</div>

		<div class="form-field">
			<label>Perception</label>
			<input type="number" name="skills[perception]">
		</div>

		<div class="form-field">
			<label>Sense Motive</label>
			<input type="number" name="skills[sense_motive]">
		</div>

	</div>

	<div class="form-row">

		<div class="form-field">
			<label>Reflex</label>
			<input type="number" name="skills[reflex]">
		</div>

		<div class="form-field">
			<label>Fortitude</label>
			<input type="number" name="skills[fortitude]">
		</div>

		<div class="form-field">
			<label>Will</label>
			<input type="number" name="skills[will]">
		</div>

	</div>

	<div class="form-field">
		<label>Specials (Rerolls, Autos, Extra Dice)</label>
		<textarea rows="4" name="skills[rerolls]"></textarea>
	</div>

	<div class="form-field">
		<label>Conditional Modifiers</label>
		<textarea rows="4" name="skills[notes]"></textarea>
	</div>

	<h2>Movement</h2>

	<div id="movement-container">
		<!-- Intentionally empty, populated via script -->
	</div>

	<button type="button" class="btn fmt-btn" id="add-movement">
		+ Add Movement
	</button>

	<button type="button" class="btn fmt-btn" id="remove-movement">
		- Remove Movement
	</button>

	<!-- Formatting Buttons -->
	<div class="form-formatting">
		<button type="button" class="btn fmt-btn" data-tag="b"><b>Bold</b></button>
		<button type="button" class="btn fmt-btn" data-tag="i"><i>Italic</i></button>
		<button type="button" class="btn fmt-btn" data-tag="q"><b>Quote</b></button>
		<button type="button" class="btn fmt-btn" data-tag="sup">Sup</button>
		<button type="button" class="btn fmt-btn" data-tag="sub">Sub</button>
	</div>

	<!-- Actions -->
	<div class="form-actions">

		<button type="submit" class="btn btn-primary">
			Save Mechanics
		</button>

		<a href="/builder/pc/<%= pc.id %>/edit?tab=character" class="btn fmt-btn">
			Back
		</a>

	</div>

</form>