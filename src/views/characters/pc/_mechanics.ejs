<form action="/builder/pc/<%= pc.id %>/edit/mechanics" method="POST" class="note-form">

	<h2>Attributes</h2>
	<div class="form-row">

		<div class="form-field">
			<label>STR</label>
			<input type="number" name="attributes[strength]" placeholder="10"
				value="<%= pc.attributes?.[0]?.strength || '' %>">
		</div>

		<div class="form-field">
			<label>DEX</label>
			<input type="number" name="attributes[dexterity]" placeholder="10"
				value="<%= pc.attributes?.[0]?.dexterity || '' %>">
		</div>

		<div class="form-field">
			<label>CON</label>
			<input type="number" name="attributes[constitution]" value="<%= pc.attributes?.[0]?.constitution || '' %>">
		</div>

	</div>

	<div class="form-row">

		<div class="form-field">
			<label>INT</label>
			<input type="number" name="attributes[intelligence]" placeholder="10"
				value="<%= pc.attributes?.[0]?.intelligence || '' %>">
		</div>

		<div class="form-field">
			<label>WIS</label>
			<input type="number" name="attributes[wisdom]" placeholder="10" value="<%= pc.attributes?.[0]?.wisdom || '' %>">
		</div>

		<div class="form-field">
			<label>CHA</label>
			<input type="number" name="attributes[charisma]" placeholder="10"
				value="<%= pc.attributes?.[0]?.charisma || '' %>">
		</div>

	</div>

	<div class="form-row">

		<div class="form-field">
			<label for="alignment">Alignment</label>
			<input type="text" id="alignment" name="attributes[alignment]" placeholder="Neutral"
				value="<%= pc.attributes?.[0]?.alignment || '' %>">
		</div>

		<div class="form-field">
			<label>Attribute Notes</label>
			<textarea rows="4" name="attributes[notes]" value="<%= pc.stats?.[0]?.main_ac || '' %>"></textarea>
		</div>

	</div>

	<h2>Combat Statistics</h2>

	<div class="form-row">

		<div class="form-field">
			<label>AC</label>
			<input type="number" name="stats[main_ac]" placeholder="10" value="<%= pc.stats?.[0]?.main_ac || '' %>">
		</div>

		<div class="form-field">
			<label>Flat AC</label>
			<input type="number" name="stats[flat_ac]" placeholder="10" value="<%= pc.stats?.[0]?.flat_ac || '' %>">
		</div>

		<div class="form-field">
			<label>Touch AC</label>
			<input type="number" name="stats[touch_ac]" placeholder="10" value="<%= pc.stats?.[0]?.touch_ac || '' %>">
		</div>

	</div>

	<div class="form-row">

		<div class="form-field">
			<label>CMD</label>
			<input type="number" name="stats[cmd]" placeholder="10" value="<%= pc.stats?.[0]?.cmd || '' %>">
		</div>

		<div class="form-field">
			<label>Max HP</label>
			<input type="number" name="stats[max_hp]" placeholder="8" value="<%= pc.stats?.[0]?.max_hp || '' %>">
		</div>

	</div>

	<div class="form-field">
		<label>Conditional Modifiers</label>
		<textarea rows="4" name="stats[notes]"><%= pc.stats?.[0]?.notes || '' %></textarea>
	</div>

	<h2>Skills & Saves</h2>

	<div class="form-row">

		<div class="form-field">
			<label>Initiative</label>
			<input type="number" name="skills[initiative]" placeholder="0" value="<%= pc.skills?.[0]?.initiative || '' %>">
		</div>

		<div class="form-field">
			<label>Perception</label>
			<input type="number" name="skills[perception]" placeholder="0" value="<%= pc.skills?.[0]?.perception || '' %>">
		</div>

		<div class="form-field">
			<label>Sense Motive</label>
			<input type="number" name="skills[sense_motive]" placeholder="0"
				value="<%= pc.skills?.[0]?.sense_motive || '' %>">
		</div>

	</div>

	<div class="form-row">

		<div class="form-field">
			<label>Disguise</label>
			<input type="number" name="skills[disguise]" placeholder="0" value="<%= pc.skills?.[0]?.disguise || '' %>">
		</div>

		<div class="form-field">
			<label>Stealth</label>
			<input type="number" name="skills[stealth]" placeholder="0" value="<%= pc.skills?.[0]?.stealth || '' %>">
		</div>

		<div class="form-field">
			<label>Disable Device</label>
			<input type="number" name="skills[disable_device]" placeholder="0"
				value="<%= pc.skills?.[0]?.disable_device || '' %>">
		</div>

	</div>

	<div class="form-row">

		<div class="form-field">
			<label>Reflex</label>
			<input type="number" name="skills[reflex]" placeholder="0" value="<%= pc.skills?.[0]?.reflex || '' %>">
		</div>

		<div class="form-field">
			<label>Fortitude</label>
			<input type="number" name="skills[fortitude]" placeholder="0" value="<%= pc.skills?.[0]?.fortitude || '' %>">
		</div>

		<div class="form-field">
			<label>Will</label>
			<input type="number" name="skills[will]" placeholder="0" value="<%= pc.skills?.[0]?.will || '' %>">
		</div>

	</div>

	<div class="form-field">
		<label>Specials (Rerolls, Autos, Extra Dice)</label>
		<textarea rows="4" name="skills[rerolls]"><%= pc.skills?.[0]?.rerolls || '' %></textarea>
	</div>

	<div class="form-field">
		<label>Conditional Modifiers</label>
		<textarea rows="4" name="skills[notes]"><%= pc.skills?.[0]?.notes || '' %></textarea>
	</div>

	<h2>Movement</h2>

	<div id="movement-container">
		<% if (pc.speeds && pc.speeds.length) { %>
		<% pc.speeds.forEach((speed, index) => { %>
		<div class="movement-row">
			<div class="form-row">

				<div class="form-field">
					<label> Movement Type </label>
					<select name="speeds[<%= index %>][speed_id]">

						<option value=""> Select Movement </option>

						<% speeds.forEach(speedOption => { %>
						<option value="<%= speedOption.id %>"
							<%= Number(speedOption.id) === Number(speed.speed_id) ? "selected" : "" %>>
							<%= speedOption.name %>
						</option>
						<% }) %>
					</select>
				</div>

				<div class="form-field">
					<label> Speed Value </label>
					<input type="number" min="0" name="speeds[<%= index %>][speed_value]" value="<%= speed.speed_value || 30 %>">
				</div>

			</div>
		</div>
		<% }) %>
		<% } %>
	</div>

	<button type="button" class="btn fmt-btn" id="add-movement">
		+ Add Movement
	</button>

	<button type="button" class="btn fmt-btn" id="remove-movement">
		- Remove Movement
	</button>

	<!-- Formatting Buttons -->
	<div class="form-formatting">
		<button type="button" class="btn fmt-btn" data-tag="b"><b>Bold</b></button>
		<button type="button" class="btn fmt-btn" data-tag="i"><i>Italic</i></button>
		<button type="button" class="btn fmt-btn" data-tag="q"><b>Quote</b></button>
		<button type="button" class="btn fmt-btn" data-tag="sup">Sup</button>
		<button type="button" class="btn fmt-btn" data-tag="sub">Sub</button>
	</div>

	<!-- Actions -->
	<div class="form-actions">

		<button type="submit" class="btn btn-primary">
			Save Mechanics
		</button>

		<a href="/builder/pc/<%= pc.id %>/edit?tab=character" class="btn fmt-btn">
			Back
		</a>

	</div>

</form>